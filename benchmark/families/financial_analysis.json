      "difficulty": 3,
      "verification": {
        "type": "function_test",
        "entry_point": "expense_ratio",
        "test_cases": [
          {
            "inputs": [[{"category": "food", "amount": 25}, {"category": "rent", "amount": 75}], 100],
            "expected": {"food": 0.25, "rent": 0.75},
            "description": "占比计算"
          },
          {
            "inputs": [[{"category": "a", "amount": 1}, {"category": "a", "amount": 1}], 4],
            "expected": {"a": 0.5},
            "description": "同类别累加后再算占比"
          }
        ],
        "timeout_seconds": 5
      },
      "metadata": {"source": "skillflow_style_family_v1", "family_step": 3}
    },
    {
