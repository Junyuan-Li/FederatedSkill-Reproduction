            "expected": {"food": 15, "rent": 100},
            "description": "按类别汇总"
          },
          {"inputs": [[]], "expected": {}, "description": "空列表返回空dict"}
        ],
        "timeout_seconds": 5
      },
      "metadata": {"source": "skillflow_style_family_v1", "family_step": 2}
    },
    {
      "task_id": "financial_analysis_d3_ratio",
      "category": "financial_analysis",
      "family_id": "financial_analysis",
      "description": "Write a Python function named `expense_ratio` that takes `records` (list of dicts with 'category' and 'amount' keys) and `total_budget` (number). Compute per-category totals (like `category_totals`), then return a dict mapping category to round(total / total_budget, 4).",
